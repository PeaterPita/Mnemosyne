---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Empty from "../../components/Empty.astro";

import placeholder from "../../assets/placeholder.webp";
const all = await getCollection("projects");

const featured = all.find((project) => project.data.featured) ?? all[0];
const remainder = all.filter((project) => project !== featured);
---

<!-- TODO 
Project tags 
Project [id] pages 

-->

<Layout title="Projects">
    {all.length === 0 ? (
        <Empty />
    ) : (
        <section class="projects">
            {featured && (
                <article class="featured">
                    <div class="media">
                        <Image
                            src={featured.data.image ?? placeholder}
                            alt=""
                        />
                    </div>
                    <div>
                        <p class="feat">Featured Project</p>
                        <h1>{featured.data.title}</h1>
                        <p>{featured.data.description}</p>
                        <a href={`projects/${featured.id}`}>View Project</a>
                    </div>
                </article>
            )}

            <ul class="grid">
                {remainder.map((project) => (
                    <li>
                        <a href={`projects/${project.id}`}>
                            <div class="media">
                                <Image
                                    src={project.data.image ?? placeholder}
                                    alt=""
                                />
                            </div>
                            <h2>{project.data.title}</h2>
                            <p class="meta"></p>
                        </a>
                    </li>
                ))}
            </ul>
        </section>
    )}
</Layout>

<style>
    .projects {
        width: 80vw;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .featured {
        display: grid;
        gap: 1.5rem;
        align-items: start;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid
            color-mix(in srgb, var(--muted) 18%, transparent);
    }

    .grid {
        list-style: none;
        margin: 0;
        padding: 0;

        display: grid;
        gap: 2rem 1.5rem;
    }

    .grid a {
        display: block;
    }

    .media {
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 0.5rem;
    }

    .media :global(img) {
        width: 100%;
        height: 100%;
    }

    .feat {
        margin: 0;
        text-transform: uppercase;
        color: var(--muted);
    }

    h1,
    h2 {
        font-family: var(--font-title);
    }

    h1 {
        margin: 0.4rem 0 0;
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    .grid a:hover {
        text-decoration: underline;
    }

    @media (min-width: 768px) {
        .featured {
            grid-template-columns: 1.3fr 1fr;
        }
        .grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>

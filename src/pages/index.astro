---
import Layout from "../layouts/Layout.astro";
import Links from "../components/Links.astro";
---

<Layout>
    <section class="hero">
        <h1>
            Hi, I'm <span class="name"> PeaterPita </span>
        </h1>

        <p class="about">
            BSc Computing graduate focused on systems programming, network
            security, and self-hosted infrastructure; A persistent self-directed
            learner.
        </p>

        <p>I build things to be useful</p>
        <Links />
    </section>
</Layout>

<style>
    .hero {
        width: min(100%, 90vw);
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        padding-left: 1.5rem;
    }

    @media (min-width: 1024px) {
        .hero {
            margin: auto;
            max-width: 40vw;
            justify-content: center;
            align-items: center;
            text-align: center;

            padding-left: 0;
        }
    }

    h1 {
        margin: 0;
        font-size: 2rem;
        font-family: var(--font-title);
    }

    .about {
        margin: 0;
    }

    .name {
        color: var(--accent);
    }
</style>

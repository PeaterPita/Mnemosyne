---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import Icon from "../../components/Icon.astro";
import Empty from "../../components/Empty.astro";
import Seperator from "../../components/Seperator.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const all = await getCollection("projects");

const featured = all.find((project) => project.data.featured) ?? all[0];
const remainder = all.filter((project) => project !== featured);
---

<!-- TODO 
Project [id] pages 
-->

<Layout title="Projects">
    {all.length === 0 ? (
        <Empty />
    ) : (
        <section class="projects">
            {featured && <ProjectCard project={featured} featured={true} />}

            <ul class="grid">
                {remainder.map((project) => (
                    <li>
                        <ProjectCard {project} />
                    </li>
                ))}
            </ul>

            <Seperator />

            <aside class="more">
                <h3>I'm constantly making new things</h3>
                <p>Check out my Github for more...</p>

                <a href="https://github.com/PeaterPita">
                    <Icon name="github-fill" size={24} />
                </a>
            </aside>
        </section>
    )}
</Layout>

<style>
    .projects {
        width: 80vw;

        /* Remove with better solution */
        max-width: 1200px;

        margin-inline: auto;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .grid {
        list-style: none;
        margin: 0;
        padding: 0;

        display: grid;
        gap: 2rem 1.5rem;
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    .more {
        display: flex;
        flex-direction: column;
        text-align: center;

        margin-bottom: 1.5rem;
    }

    .more h3,
    .more p {
        margin: 0;
    }

    .more a {
        margin-top: 0.5rem;
    }

    @media (min-width: 768px) {
        .grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>

---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Icon from "../../components/Icon.astro";
import Tag from "../../components/Tag.astro";
import Empty from "../../components/Empty.astro";
import Seperator from "../../components/Seperator.astro";
import ProjectCard from "../../components/ProjectCard.astro";

import placeholder from "../../assets/placeholder.webp";
const all = await getCollection("projects");

const featured = all.find((project) => project.data.featured) ?? all[0];
const remainder = all.filter((project) => project !== featured);
---

<!-- TODO 
Project [id] pages 
Reduce featured down to same projectCard component
-->

<Layout title="Projects">
    {all.length === 0 ? (
        <Empty />
    ) : (
        <section class="projects">
            {featured && (
                <article class="featured">
                    <div class="media">
                        <Image
                            src={featured.data.image ?? placeholder}
                            alt=""
                        />
                    </div>
                    <div>
                        <p class="feat">Featured Project</p>
                        <h1>{featured.data.title}</h1>
                        <p>{featured.data.description}</p>
                        <div class="meta">
                            {featured.data.tags.map((tag) => (
                                <Tag {tag} />
                            ))}
                        </div>

                        <div class="links">
                            {featured.data.repo && (
                                <a href={featured.data.repo}>
                                    <Icon name="github-fill" size={24} />
                                </a>
                            )}
                        </div>
                    </div>
                </article>
            )}

            <ul class="grid">
                {remainder.map((project) => (
                    <li>
                        <ProjectCard {project} />
                    </li>
                ))}
            </ul>

            <Seperator />

            <aside class="more">
                <h3>I'm constantly making new things</h3>
                <p>Check out my Github for more...</p>

                <a href="https://github.com/PeaterPita">
                    <Icon name="github-fill" size={24} />
                </a>
            </aside>
        </section>
    )}
</Layout>

<style>
    .projects {
        width: 80vw;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .featured {
        display: grid;
        gap: 1.5rem;
        align-items: start;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid
            color-mix(in srgb, var(--muted) 18%, transparent);
    }

    .grid {
        list-style: none;
        margin: 0;
        padding: 0;

        display: grid;
        gap: 2rem 1.5rem;
    }

    .media {
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 0.5rem;
    }

    .media :global(img) {
        width: 100%;
        height: 100%;
    }

    .feat {
        margin: 0;
        text-transform: uppercase;
        color: var(--muted);
    }

    .meta {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    h1,
    h2 {
        font-family: var(--font-title);
        margin: 0.4rem 0 0;
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    .grid a:hover h2 {
        text-decoration: underline;
    }

    .more {
        display: flex;
        flex-direction: column;
        text-align: center;

        margin-bottom: 1.5rem;
    }

    .more h3,
    .more p {
        margin: 0;
    }

    .more a {
        margin-top: 0.5rem;
    }

    @media (min-width: 768px) {
        .featured {
            grid-template-columns: 1.3fr 1fr;
        }
        .grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>

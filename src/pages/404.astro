---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="404">
    <section>
        <h1>404</h1>
        <p>You look lost there...</p>
        <a href="/" class="home">
            <Icon name="arrow-left-line" size={24} />
            <span>Back home</span>
        </a>
    </section>
</Layout>

<style>
    section {
        display: flex;
        flex-direction: column;

        align-items: center;
        justify-content: center;
    }

    h1 {
        margin: 0;
        font-size: 4rem;
        font-family: var(--font-title);
    }

    p {
        margin: 0;
    }

    .home {
        display: flex;
        align-items: center;
        gap: 0.5rem;

        color: var(--muted);
        text-decoration: none;
    }

    .home:hover {
        color: var(--fg);
    }
</style>

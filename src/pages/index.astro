---
import Layout from "../layouts/Layout.astro";
import Links from "../components/Links.astro";
---

<Layout>
    <section class="hero">
        <h1>Hi, I'm PeaterPita</h1>

        <p class="about">
            BSc Computing graduate focused on systems programming, network
            security, and self-hosted infrastructure; A persistent self-directed
            learner. I build things to be useful!
        </p>

        <Links />
    </section>
</Layout>

<style>
    .hero {
        height: 100%;
        width: 100%;
        max-width: 100vw;

        padding: 3.5rem 1.5rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    @media (min-width: 1024px) {
        .hero {
            margin: auto;
            max-width: 40vw;
            justify-content: center;
            align-items: center;
            text-align: center;
        }
    }

    h1 {
        margin: 0;
        font-size: 2rem;
        font-family: var(--font-title);
    }

    .about {
        margin: 0;
    }
</style>

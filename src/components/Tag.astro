---
const { tag } = Astro.props;

const tagColors = ["astro", "c"];
const tagClass = tagColors.includes(tag.toLowerCase())
    ? `tag-${tag.toLowerCase()}`
    : `tag-default`;
---

<span class=`tag ${tagClass}`>{tag}</span>

<style>
    .tag {
        display: inline-block;
        border-radius: 1rem;
        font-size: 0.75rem;

        padding: 0.125rem 0.625rem;
        border: 1px solid var(--muted);
    }

    /* TODO: More Tag Colors
    nix
    astro
    python
    */

    .tag-c {
        background-color: #f4e8ff;
        color: #6b21a8;
    }

    .tag-default {
        background-color: color-mix(in srgb, var(--fg) 5%, transparent);
        color: var(--fg);
    }
</style>

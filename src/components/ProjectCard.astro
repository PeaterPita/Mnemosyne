---
import Tag from "../components/Tag.astro";
import placeholder from "../assets/placeholder.webp";

const { project, featured = false } = Astro.props;
import { Image } from "astro:assets";
import Icon from "../components/Icon.astro";
---

<article class={`project ${featured ? "featured" : ""}`}>
    <a href={`/projects/${project.id}`}>
        <div class="media">
            <Image src={project.data.image ?? placeholder} alt="" />
        </div>
    </a>

    <div class="content">
        <div class="links">
            {project.data.url && (
                <a href={project.data.url}>
                    <Icon name="external-link-line" size={24} />
                </a>
            )}

            {project.data.repo && (
                <a href={project.data.repo}>
                    <Icon name="github-fill" size={24} />
                </a>
            )}
        </div>

        {featured && <p class="feat">Featured Project</p>}
        <h2 class="title">
            <a href={`/projects/${project.id}`}>{project.data.title}</a>
        </h2>
        <p>{project.data.description}</p>

        <div class="meta">
            {project.data.tags.map((tag) => (
                <Tag {tag} />
            ))}
        </div>
    </div>
</article>

<style>
    .project {
        display: grid;
    }

    .project.featured {
        gap: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid
            color-mix(in srgb, var(--muted) 18%, transparent);
    }

    .media {
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 0.5rem;
        border: 1px solid color-mix(in srgb, var(--muted) 28%, transparent);

        box-shadow:
            0 1rem 2.5rem -0.75rem rgba(0, 0, 0, 0.25),
            0 0.25rem 0.5rem -0.25rem rgba(0, 0, 0, 0.1);
    }

    .feat {
        margin: 0;
        text-transform: uppercase;
        color: var(--muted);
    }

    .media :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .content {
        display: flex;
        position: relative;
        flex-grow: 1;
        flex-direction: column;
    }

    .meta {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .title {
        font-family: var(--font-title);
        padding-right: 2.5rem;
        margin: 0.4rem 0 0;
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    .links {
        position: absolute;
        right: 0.5rem;
        top: 0.5rem;
        display: flex;
        gap: 0.25rem;
    }

    @media (min-width: 768px) {
        .project.featured {
            grid-template-columns: 1.3fr 1fr;
        }

        .project.featured .links {
            top: auto;
            bottom: 0;
        }
    }
</style>

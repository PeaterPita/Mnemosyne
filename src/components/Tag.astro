---
const { tag } = Astro.props;
---

<span class="tag">{tag}</span>

<style>
    .tag {
        display: inline-block;
        border-radius: 1rem;

        padding: 0.125rem 0.625rem;
        font-weight: 600;
        font-size: 0.9rem;

        background-color: color-mix(in srgb, var(--fg) 5%, transparent);
        color: var(--fg);
    }
</style>
